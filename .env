# WebSocket server URL used by the client.
# Secure WebSocket via Caddy (Let's Encrypt) in front of the Oracle Cloud
# instance, using the DuckDNS subdomain. wss:// is required because the
# client is served over https:// on Netlify (mixed content blocks ws://).
# For local dev, create a .env.local file (git-ignored) with:
#   VITE_WS_URL=ws://localhost:2121
VITE_WS_URL=wss://bingochatapp.duckdns.org
